# MDTV+ — Hostinger production hardening
# Performance · Cache · Security

Options -Indexes
ServerSignature Off

# ---------- Baseline security headers (sitio completo) ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------- Never cache live signal JSON ----------
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Extra safety for the live config path
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/config\.json$ - [E=NO_CACHE:1]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
</IfModule>

# ---------- Fast cache for static assets ----------
<IfModule mod_expires.c>
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ---------- Compression (GZIP) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Brotli when the host module is available (Hostinger often has it)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

# ---------- Pretty URLs: noticias + sitemap ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block PHP execution inside uploads
  RewriteRule ^assets/uploads/.*\.(?i:php|phtml|php3|php4|php5|phar|cgi|pl|asp|aspx)$ - [F,L]

  # Canonical: /noticia.php?slug=x → /noticias/x
  RewriteCond %{THE_REQUEST} \s/+noticia\.php\?slug=([a-z0-9-]+)\s [NC]
  RewriteRule ^noticia\.php$ /noticias/%1? [R=301,L]

  # Pretty routes
  RewriteRule ^noticias/?$ noticias.php [L,QSA]
  RewriteRule ^noticias/([a-z0-9-]+)/?$ noticia.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
